{
  "name": "doc-archive",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "1.7.18",
    "better-auth": "1.7.18",
    "drizzle-orm": "0.45.4",
    "next": "16.4.5",
    "postgres": "3.4.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "pdf-lib": "1.17.1",
    "tesseract.js": "6.0.1"
  },
  "devDependencies": {
    "@types/node": "22.19.13",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.1",
    "eslint-config-next": "16.4.5",
    "typescript": "5.9.3",
    "dotenv": "16.6.1"
  }
}
